<div class="page-header">
  <div>
    <span class="eyebrow">Administration</span>
    <h1 class="h3 mb-0"><%= title %></h1>
  </div>
  <a href="/admin/projects" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to Projects</a>
</div>

<div class="panel p-4" style="max-width: 680px;">
  <%- include('../../partials/form-errors') %>

  <form action="<%= formAction %>" method="POST" novalidate>
    <div class="mb-3">
      <label class="form-label">Project Name</label>
      <input type="text" name="name" class="form-control" value="<%= project.name || '' %>" required maxlength="120" placeholder="e.g. Customer Portal Revamp" />
    </div>
    <div class="mb-3">
      <label class="form-label">Description</label>
      <textarea name="description" class="form-control" rows="4" required maxlength="2000" placeholder="What is this project about?"><%= project.description || '' %></textarea>
    </div>
    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">Start Date</label>
        <input type="date" name="startDate" class="form-control" required value="<%= project.startDate ? dayjs(project.startDate).format('YYYY-MM-DD') : '' %>" />
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label">End Date</label>
        <input type="date" name="endDate" class="form-control" required value="<%= project.endDate ? dayjs(project.endDate).format('YYYY-MM-DD') : '' %>" />
      </div>
    </div>
    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">Priority</label>
        <select name="priority" class="form-select" required>
          <% PROJECT_PRIORITY.forEach(p => { %><option value="<%= p %>" <%= project.priority === p ? 'selected' : '' %>><%= p %></option><% }) %>
        </select>
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label">Status</label>
        <select name="status" class="form-select" required>
          <% PROJECT_STATUS.forEach(s => { %><option value="<%= s %>" <%= project.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
        </select>
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label">Project Manager</label>
      <select name="projectManager" class="form-select">
        <option value="">— Unassigned —</option>
        <% managers.forEach(m => { %>
          <option value="<%= m._id %>" <%= (project.projectManager && project.projectManager.toString() === m._id.toString()) ? 'selected' : '' %>><%= m.name %> (<%= m.email %>)</option>
        <% }) %>
      </select>
      <div class="form-text">Team members are added to the project by its Project Manager once assigned.</div>
    </div>

    <div class="d-flex gap-2 mt-4">
      <button type="submit" class="btn btn-ember px-4">Save Project</button>
      <a href="/admin/projects" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>
</div>
