<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>

<body>

  <div class="auth-page">

    <!-- ================= LEFT SIDE ================= -->
    <section class="auth-info">

      <div class="auth-info-content">

        <!-- Brand -->
        <div class="auth-brand">
          <span class="brand-mark">
            <i class="bi bi-kanban-fill"></i>
          </span>
          <span class="brand-name">TaskForge</span>
        </div>

        <!-- Intro -->
        <div class="auth-intro">

          <span class="auth-eyebrow">
            PROJECT MANAGEMENT PLATFORM
          </span>

          <h1>
            Build better.<br>
            <span>Work smarter.</span>
          </h1>

          <p>
            TaskForge brings projects, tasks, teams and progress
            together in one organized workspace. Stay focused,
            collaborate efficiently and keep every deadline on track.
          </p>

        </div>

        <!-- Features -->
        <div class="auth-features">

          <div class="auth-feature">
            <div class="auth-feature-icon">
              <i class="bi bi-kanban"></i>
            </div>

            <div>
              <strong>Organize your projects</strong>
              <span>
                Keep projects structured with clear tasks,
                priorities and progress tracking.
              </span>
            </div>
          </div>

          <div class="auth-feature">
            <div class="auth-feature-icon">
              <i class="bi bi-people"></i>
            </div>

            <div>
              <strong>Work as a team</strong>
              <span>
                Manage team members, assignments and
                responsibilities from one place.
              </span>
            </div>
          </div>

          <div class="auth-feature">
            <div class="auth-feature-icon">
              <i class="bi bi-graph-up-arrow"></i>
            </div>

            <div>
              <strong>Track progress</strong>
              <span>
                Monitor project progress and stay on top
                of important deadlines.
              </span>
            </div>
          </div>

        </div>

        <!-- Footer -->
        <div class="auth-info-footer">
          <span></span>
          <small>Built for productive teams</small>
        </div>

      </div>

    </section>


    <!-- ================= RIGHT SIDE ================= -->
    <section class="auth-form-side">

      <div class="auth-form-container">

        <!-- Mobile brand -->
        <div class="auth-mobile-brand">
          <span class="brand-mark">
            <i class="bi bi-kanban-fill"></i>
          </span>

          <span class="brand-name">
            TaskForge
          </span>
        </div>


        <!-- Heading -->
        <div class="auth-heading">

          <span class="auth-form-eyebrow">
            WELCOME BACK
          </span>

          <h2>Sign in to your workspace</h2>

          <p>
            Enter your credentials to continue to TaskForge.
          </p>

        </div>


        <!-- Flash messages -->
        <%- include('../partials/flash') %>
        <%- include('../partials/form-errors') %>


        <!-- Login form -->
        <form action="/login" method="POST" novalidate>

          <!-- Email -->
          <div class="mb-3">

            <label class="form-label" for="email">
              Email address
            </label>

            <div class="auth-input">

              <i class="bi bi-envelope"></i>

              <input
                type="email"
                class="form-control"
                id="email"
                name="email"
                value="<%= oldInput.email || '' %>"
                required
                autofocus
                placeholder="you@company.com"
              />

            </div>

          </div>


          <!-- Password -->
          <div class="mb-3">

            <label class="form-label" for="password">
              Password
            </label>

            <div class="auth-input">

              <i class="bi bi-lock"></i>

              <input
                type="password"
                class="form-control"
                id="password"
                name="password"
                required
                placeholder="Enter your password"
              />

            </div>

          </div>


          <!-- Login button -->
          <button
            type="submit"
            class="btn btn-ember w-100 auth-submit"
          >
            <span>Sign In</span>
            <i class="bi bi-arrow-right"></i>
          </button>

        </form>


        <!-- Divider -->
        <div class="auth-divider">
          <span>ACCOUNT ACCESS</span>
        </div>


        <!-- Note -->
        <p class="auth-note">
          <i class="bi bi-shield-check"></i>

          <span>
            Accounts are created by your Administrator.
            Contact them if you need access to the platform.
          </span>
        </p>

      </div>

    </section>

  </div>


  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>

</body>
</html>