<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-card text-center">
      <div class="display-1 fw-bold mb-2" style="color: var(--ember); font-family: var(--font-display);"><%= statusCode %></div>
      <h1 class="h5 mb-2">
        <%= statusCode === 404 ? 'Page not found' : statusCode === 403 ? 'Access denied' : 'Something went wrong' %>
      </h1>
      <p class="text-muted small mb-4"><%= message %></p>
      <a href="/dashboard" class="btn btn-ember px-4">Back to Dashboard</a>
    </div>
  </div>
</body>
</html>
