<div class="page-header">

  <div>

    <span class="eyebrow">Team Management</span>

    <h1 class="h3 mb-0">
      Team Attendance
    </h1>

    <p class="text-muted mb-0">
      Monitor attendance and working hours of your team members.
    </p>

  </div>

</div>


<div class="panel p-4">

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>

      <h2 class="h6 mb-1">
        Attendance Records
      </h2>

      <p class="text-muted small mb-0">
        Attendance history of team members
      </p>

    </div>

    <span class="stamp stamp-completed">
      <%= attendance.length %> Records
    </span>

  </div>


  <% if (!attendance.length) { %>

    <div class="empty-state py-5">

      <i class="bi bi-calendar-check"></i>

      <p class="mb-0">
        No attendance records found.
      </p>

    </div>

  <% } else { %>

   <!-- DESKTOP TABLE -->
<div class="attendance-table-desktop">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead>
        <tr>
          <th>Team Member</th>
          <th>Date</th>
          <th>Check In</th>
          <th>Check Out</th>
          <th>Status</th>
          <th>Working Hours</th>
        </tr>
      </thead>

      <tbody>
        <% attendance.forEach(record => { %>

          <tr>

            <td>
              <% if (record.user) { %>
                <div class="fw-semibold">
                  <%= record.user.name %>
                </div>

                <div class="text-muted small">
                  <%= record.user.email %>
                </div>
              <% } else { %>
                <span class="text-muted">
                  User unavailable
                </span>
              <% } %>
            </td>

            <td>
              <%= dayjs(record.date).format('MMM D, YYYY') %>
            </td>

            <td>
              <% if (record.checkIn) { %>
                <%= dayjs(record.checkIn).format('hh:mm A') %>
              <% } else { %>
                —
              <% } %>
            </td>

            <td>
              <% if (record.checkOut) { %>
                <%= dayjs(record.checkOut).format('hh:mm A') %>
              <% } else { %>
                —
              <% } %>
            </td>

            <td>
              <span class="stamp
                <%= record.status === 'Late'
                  ? 'stamp-warning'
                  : record.status === 'Present'
                  ? 'stamp-completed'
                  : 'stamp-critical' %>">

                <%= record.status %>

              </span>
            </td>

            <td>
              <% if (record.checkOut) { %>
                <%= record.workingHours %> hrs
              <% } else { %>
                <span class="text-muted">
                  In progress
                </span>
              <% } %>
            </td>

          </tr>

        <% }) %>
      </tbody>
    </table>
  </div>
</div>


<!-- MOBILE CARDS -->
<div class="attendance-mobile-list">

  <% attendance.forEach(record => { %>

    <div class="attendance-mobile-card">

      <!-- CARD TOP -->
      <div class="attendance-mobile-top">

        <div class="attendance-mobile-user">

          <span class="avatar-sm">
            <%= record.user?.name
              ? record.user.name
                  .split(' ')
                  .map(n => n[0])
                  .join('')
                  .substring(0, 2)
                  .toUpperCase()
              : 'U'
            %>
          </span>

          <div class="attendance-mobile-name">

            <strong>
              <%= record.user?.name || 'User unavailable' %>
            </strong>

            <% if (record.user?.email) { %>
              <span>
                <%= record.user.email %>
              </span>
            <% } %>

          </div>

        </div>

        <span class="stamp
          <%= record.status === 'Late'
            ? 'stamp-warning'
            : record.status === 'Present'
            ? 'stamp-completed'
            : 'stamp-critical' %>">

          <%= record.status %>

        </span>

      </div>


      <!-- DETAILS -->
      <div class="attendance-mobile-details">

        <div>
          <small>Date</small>

          <strong>
            <%= dayjs(record.date).format('MMM D, YYYY') %>
          </strong>
        </div>


        <div>
          <small>Check In</small>

          <strong>
            <% if (record.checkIn) { %>
              <%= dayjs(record.checkIn).format('hh:mm A') %>
            <% } else { %>
              —
            <% } %>
          </strong>
        </div>


        <div>
          <small>Check Out</small>

          <strong>
            <% if (record.checkOut) { %>
              <%= dayjs(record.checkOut).format('hh:mm A') %>
            <% } else { %>
              —
            <% } %>
          </strong>
        </div>


        <div>
          <small>Working Hours</small>

          <% if (record.checkOut) { %>

            <strong>
              <%= record.workingHours %> hrs
            </strong>

          <% } else { %>

            <strong class="text-muted">
              In progress
            </strong>

          <% } %>

        </div>

      </div>

    </div>

  <% }) %>

</div>

  <% } %>

</div>