<div class="page-header">
  <div>
    <span class="eyebrow">My Workspace</span>

    <h1 class="h3 mb-0">
      My Attendance
    </h1>

    <p class="text-muted mb-0">
      View your attendance history and working hours.
    </p>
  </div>
</div>


<div class="panel p-4">

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h2 class="h6 mb-1">
        Attendance Records
      </h2>

      <p class="text-muted small mb-0">
        Your attendance history
      </p>
    </div>

    <span class="stamp stamp-completed">
      <%= attendance.length %> Records
    </span>

  </div>


  <% if (!attendance.length) { %>

    <div class="empty-state py-5">

      <i class="bi bi-calendar-check"></i>

      <p class="mb-0">
        No attendance records found.
      </p>

    </div>

  <% } else { %>


    <!-- ============================= -->
    <!-- DESKTOP TABLE -->
    <!-- ============================= -->

    <div class="my-attendance-table-desktop">

      <div class="table-responsive">

        <table class="table align-middle mb-0">

          <thead>
            <tr>
              <th>Date</th>
              <th>Check In</th>
              <th>Check Out</th>
              <th>Status</th>
              <th>Working Hours</th>
            </tr>
          </thead>


          <tbody>

            <% attendance.forEach(record => { %>

              <tr>

                <td class="fw-semibold">
                  <%= dayjs(record.date).format('MMM D, YYYY') %>
                </td>


                <td>

                  <% if (record.checkIn) { %>

                    <%= dayjs(record.checkIn).format('hh:mm A') %>

                  <% } else { %>

                    —

                  <% } %>

                </td>


                <td>

                  <% if (record.checkOut) { %>

                    <%= dayjs(record.checkOut).format('hh:mm A') %>

                  <% } else { %>

                    —

                  <% } %>

                </td>


                <td>

                  <span class="stamp
                    <%= record.status === 'Late'
                      ? 'stamp-warning'
                      : record.status === 'Present'
                      ? 'stamp-completed'
                      : 'stamp-critical' %>">

                    <%= record.status %>

                  </span>

                </td>


                <td>

                  <% if (record.checkOut) { %>

                    <%= record.workingHours %> hrs

                  <% } else { %>

                    <span class="text-muted">
                      In progress
                    </span>

                  <% } %>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    </div>



    <!-- ============================= -->
    <!-- MOBILE CARDS -->
    <!-- ============================= -->

    <div class="my-attendance-mobile-list">

      <% attendance.forEach(record => { %>

        <div class="my-attendance-card">


          <!-- CARD HEADER -->

          <div class="my-attendance-card-top">

            <div class="my-attendance-date">

              <div class="my-attendance-icon">
                <i class="bi bi-calendar-check"></i>
              </div>

              <div>

                <strong>
                  <%= dayjs(record.date).format('MMM D, YYYY') %>
                </strong>

                <small>
                  Attendance Record
                </small>

              </div>

            </div>


            <span class="stamp
              <%= record.status === 'Late'
                ? 'stamp-warning'
                : record.status === 'Present'
                ? 'stamp-completed'
                : 'stamp-critical' %>">

              <%= record.status %>

            </span>

          </div>



          <!-- CARD DETAILS -->

          <div class="my-attendance-details">


            <div class="my-attendance-detail">

              <small>
                Check In
              </small>

              <strong>

                <% if (record.checkIn) { %>

                  <%= dayjs(record.checkIn).format('hh:mm A') %>

                <% } else { %>

                  —

                <% } %>

              </strong>

            </div>


            <div class="my-attendance-detail">

              <small>
                Check Out
              </small>

              <strong>

                <% if (record.checkOut) { %>

                  <%= dayjs(record.checkOut).format('hh:mm A') %>

                <% } else { %>

                  —

                <% } %>

              </strong>

            </div>


            <div class="my-attendance-detail">

              <small>
                Working Hours
              </small>

              <% if (record.checkOut) { %>

                <strong>
                  <%= record.workingHours %> hrs
                </strong>

              <% } else { %>

                <strong class="text-muted">
                  In progress
                </strong>

              <% } %>

            </div>


          </div>


        </div>

      <% }) %>

    </div>


  <% } %>

</div>