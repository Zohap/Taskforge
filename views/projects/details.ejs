<div class="page-header">
  <div>
    <span class="eyebrow">Project Workspace</span>
    <h1 class="h3 mb-1"><%= project.name %></h1>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <span class="stamp <%= projectStatusClass(project.status) %>"><%= project.status %></span>
      <span class="stamp <%= priorityClass(project.priority) %>"><%= project.priority %></span>
      <span class="text-muted small"><i class="bi bi-calendar-event me-1"></i><%= dayjs(project.startDate).format('MMM D, YYYY') %> – <%= dayjs(project.endDate).format('MMM D, YYYY') %></span>
    </div>
  </div>
  <div class="d-flex gap-2">
    <% if (canManage) { %>
      <a href="/projects/<%= project._id %>/tasks/new" class="btn btn-ember"><i class="bi bi-plus-lg me-1"></i> New Task</a>
    <% } %>
    <% if (currentUser.role === 'admin') { %>
      <a href="/admin/projects/<%= project._id %>/edit" class="btn btn-outline-secondary"><i class="bi bi-pencil me-1"></i> Edit</a>
    <% } %>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="panel p-4 mb-4">
      <h2 class="h6 mb-2">Description</h2>
      <p class="text-muted mb-0"><%= project.description %></p>
    </div>

    <div class="panel p-4 mb-4">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="h6 mb-0">Progress</h2>
        <span class="text-muted small"><%= completed %> / <%= total %> tasks completed</span>
      </div>
      <div class="gauge"><div class="gauge-fill" style="width:<%= progressPct %>%"></div></div>
    </div>

    <div class="panel p-4">
      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="h6 mb-0">Tasks</h2>
      </div>

      <form method="GET" class="row g-2 align-items-center mb-3">
        <div class="col-6 col-md-3">
          <select name="status" class="form-select form-select-sm" data-auto-submit>
            <option value="">All Status</option>
            <option value="To Do" <%= query.status === 'To Do' ? 'selected' : '' %>>To Do</option>
            <option value="In Progress" <%= query.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
            <option value="Review" <%= query.status === 'Review' ? 'selected' : '' %>>Review</option>
            <option value="Completed" <%= query.status === 'Completed' ? 'selected' : '' %>>Completed</option>
          </select>
        </div>
        <div class="col-6 col-md-3">
          <select name="priority" class="form-select form-select-sm" data-auto-submit>
            <option value="">All Priority</option>
            <option value="Low" <%= query.priority === 'Low' ? 'selected' : '' %>>Low</option>
            <option value="Medium" <%= query.priority === 'Medium' ? 'selected' : '' %>>Medium</option>
            <option value="High" <%= query.priority === 'High' ? 'selected' : '' %>>High</option>
            <option value="Critical" <%= query.priority === 'Critical' ? 'selected' : '' %>>Critical</option>
          </select>
        </div>
        <div class="col-6 col-md-3">
          <select name="assignee" class="form-select form-select-sm" data-auto-submit>
            <option value="">All Members</option>
            <% project.teamMembers.forEach(m => { %>
              <option value="<%= m._id %>" <%= query.assignee === m._id.toString() ? 'selected' : '' %>><%= m.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-6 col-md-3">
          <select name="sort" class="form-select form-select-sm" data-auto-submit>
            <option value="newest" <%= query.sort === 'newest' ? 'selected' : '' %>>Newest</option>
            <option value="deadline" <%= query.sort === 'deadline' ? 'selected' : '' %>>Deadline soonest</option>
            <option value="priority" <%= query.sort === 'priority' ? 'selected' : '' %>>Priority</option>
          </select>
        </div>
      </form>

      <% if (!tasks.length) { %>
        <div class="empty-state">
          <i class="bi bi-list-check"></i>
          <p class="mb-0">No tasks match your filters yet.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table data-table mb-0">
            <thead><tr><th>Task</th><th>Assignee</th><th>Priority</th><th>Status</th><th>Due</th></tr></thead>
            <tbody>
              <% tasks.forEach(t => { %>
                <tr style="cursor:pointer" onclick="window.location='/tasks/<%= t._id %>'">
                  <td class="fw-semibold"><%= t.title %></td>
                  <td>
                    <% if (t.assignedTo) { %>
                      <span class="avatar-sm me-1" style="width:22px;height:22px;font-size:.6rem;"><%= t.assignedTo.avatarInitials %></span>
                      <%= t.assignedTo.name %>
                    <% } else { %>
                      <span class="text-muted">Unassigned</span>
                    <% } %>
                  </td>
                  <td><span class="stamp <%= priorityClass(t.priority) %>"><%= t.priority %></span></td>
                  <td><span class="stamp <%= taskStatusClass(t.status) %>"><%= t.status %></span></td>
                  <td class="text-muted small"><%= dayjs(t.dueDate).format('MMM D, YYYY') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="panel p-4 mb-4">
      <h2 class="h6 mb-3">Project Manager</h2>
      <% if (project.projectManager) { %>
        <div class="d-flex align-items-center gap-2">
          <span class="avatar-sm" style="background: linear-gradient(135deg,#3e5c76,#29405a);"><%= project.projectManager.name.split(' ').map(n=>n[0]).slice(0,2).join('') %></span>
          <div>
            <div class="fw-semibold small"><%= project.projectManager.name %></div>
            <div class="text-muted" style="font-size:.75rem;"><%= project.projectManager.email %></div>
          </div>
        </div>
      <% } else { %>
        <p class="text-muted small mb-0">No Project Manager assigned yet.</p>
      <% } %>
    </div>

    <div class="panel p-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h6 mb-0">Team Members (<%= project.teamMembers.length %>)</h2>
      </div>

      <% if (!project.teamMembers.length) { %>
        <p class="text-muted small">No team members added yet.</p>
      <% } else { %>
        <div class="d-flex flex-column gap-2 mb-3">
          <% project.teamMembers.forEach(m => { %>
            <div class="d-flex align-items-center justify-content-between">
              <div class="d-flex align-items-center gap-2">
                <span class="avatar-sm"><%= m.avatarInitials %></span>
                <div>
                  <div class="fw-semibold small"><%= m.name %></div>
                  <div class="text-muted" style="font-size:.72rem;"><%= m.jobTitle || m.email %></div>
                </div>
              </div>
              <% if (canManage) { %>
                <form action="/projects/<%= project._id %>/team/<%= m._id %>?_method=DELETE" method="POST" data-confirm="Remove <%= m.name %> from this project?">
                  <button class="btn btn-sm btn-icon text-danger" title="Remove"><i class="bi bi-x-lg"></i></button>
                </form>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>

      <% if (canManage && availableTeamMembers.length) { %>
        <form action="/projects/<%= project._id %>/team" method="POST" class="d-flex gap-2">
          <select name="userId" class="form-select form-select-sm" required>
            <option value="">Add team member…</option>
            <% availableTeamMembers.forEach(m => { %>
              <option value="<%= m._id %>"><%= m.name %></option>
            <% }) %>
          </select>
          <button class="btn btn-sm btn-ember" type="submit"><i class="bi bi-plus-lg"></i></button>
        </form>
      <% } %>
    </div>

    <% if (canManage) { %>
      <div class="panel p-4 mt-4">
        <h2 class="h6 mb-3">Update Project Status</h2>
        <form action="/projects/<%= project._id %>/status?_method=PUT" method="POST" class="d-flex gap-2">
          <select name="status" class="form-select form-select-sm" data-auto-submit>
            <option value="Planning" <%= project.status === 'Planning' ? 'selected' : '' %>>Planning</option>
            <option value="Active" <%= project.status === 'Active' ? 'selected' : '' %>>Active</option>
            <option value="On Hold" <%= project.status === 'On Hold' ? 'selected' : '' %>>On Hold</option>
            <option value="Completed" <%= project.status === 'Completed' ? 'selected' : '' %>>Completed</option>
            <option value="Cancelled" <%= project.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
          </select>
        </form>
      </div>
    <% } %>
  </div>
</div>
