<div class="page-header">
  <div>
    <span class="eyebrow"><%= project.name %></span>
    <h1 class="h3 mb-0"><%= title %></h1>
  </div>
  <a href="/projects/<%= project._id %>" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to Project</a>
</div>

<div class="panel p-4" style="max-width: 640px;">
  <%- include('../partials/form-errors') %>

  <form action="<%= formAction %>" method="POST" novalidate>
    <div class="mb-3">
      <label class="form-label">Task Title</label>
      <input type="text" name="title" class="form-control" value="<%= task.title || '' %>" required maxlength="150" placeholder="e.g. Design login page" />
    </div>
    <div class="mb-3">
      <label class="form-label">Description</label>
      <textarea name="description" class="form-control" rows="4" maxlength="2000" placeholder="Task details…"><%= task.description || '' %></textarea>
    </div>
    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">Assign To</label>
        <select name="assignedTo" class="form-select">
          <option value="">— Unassigned —</option>
          <% project.teamMembers.forEach(m => { %>
            <option value="<%= m._id %>" <%= (task.assignedTo && task.assignedTo.toString() === m._id.toString()) ? 'selected' : '' %>><%= m.name %></option>
          <% }) %>
        </select>
        <% if (!project.teamMembers.length) { %>
          <div class="form-text text-warning">No team members on this project yet — add members first.</div>
        <% } %>
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label">Priority</label>
        <select name="priority" class="form-select" required>
          <% TASK_PRIORITY.forEach(p => { %><option value="<%= p %>" <%= task.priority === p ? 'selected' : '' %>><%= p %></option><% }) %>
        </select>
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label">Due Date</label>
      <input type="date" name="dueDate" class="form-control" required value="<%= task.dueDate ? dayjs(task.dueDate).format('YYYY-MM-DD') : '' %>" />
    </div>

    <div class="d-flex gap-2 mt-4">
      <button type="submit" class="btn btn-ember px-4">Save Task</button>
      <a href="/projects/<%= project._id %>" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>
</div>
