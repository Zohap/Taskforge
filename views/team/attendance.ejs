<div class="page-header">
  <div>
    <span class="eyebrow">My Workspace</span>

    <h1 class="h3 mb-0">
      My Attendance
    </h1>

    <p class="text-muted mb-0">
      View your attendance history.
    </p>
  </div>
</div>


<!-- ========================= -->
<!-- TODAY'S ATTENDANCE -->
<!-- ========================= -->

<div class="panel p-4 mb-4">

  <div class="d-flex justify-content-between align-items-center">

    <div>
      <h2 class="h6 mb-1">
        Today's Attendance
      </h2>

      <p class="text-muted small mb-0">
        <%= dayjs().format('MMM D, YYYY') %>
      </p>
    </div>


    <% if (!todayAttendance) { %>

      <!-- CHECK IN -->

      <form action="/attendance/check-in" method="POST">

        <button type="submit" class="btn btn-ember">
          <i class="bi bi-box-arrow-in-right me-1"></i>
          Check In
        </button>

      </form>


    <% } else if (!todayAttendance.checkOut) { %>

      <!-- CHECK OUT -->

      <div class="d-flex align-items-center gap-3">

        <span class="stamp <%= todayAttendance.status === 'Late' ? 'stamp-warning' : 'stamp-completed' %>">
          <%= todayAttendance.status %>
        </span>

        <form action="/attendance/check-out" method="POST">

          <button type="submit" class="btn btn-ember">
            <i class="bi bi-box-arrow-right me-1"></i>
            Check Out
          </button>

        </form>

      </div>


    <% } else { %>

      <!-- COMPLETED -->

      <span class="stamp stamp-completed">
        <i class="bi bi-check-circle me-1"></i>
        Day Completed
      </span>

    <% } %>

  </div>


  <% if (todayAttendance) { %>

    <hr class="my-4">


    <div class="row g-3">

      <div class="col-md-4">

        <div class="text-muted small">
          Check In
        </div>

        <div class="fw-semibold">
          <%= dayjs(todayAttendance.checkIn).format('hh:mm A') %>
        </div>

      </div>


      <div class="col-md-4">

        <div class="text-muted small">
          Check Out
        </div>

        <div class="fw-semibold">

          <% if (todayAttendance.checkOut) { %>

            <%= dayjs(todayAttendance.checkOut).format('hh:mm A') %>

          <% } else { %>

            Not checked out

          <% } %>

        </div>

      </div>


      <div class="col-md-4">

        <div class="text-muted small">
          Working Hours
        </div>

        <div class="fw-semibold">

          <% if (todayAttendance.checkOut) { %>

            <%= todayAttendance.workingHours %> hours

          <% } else { %>

            In progress

          <% } %>

        </div>

      </div>

    </div>

  <% } %>

</div>



<!-- ========================= -->
<!-- ATTENDANCE HISTORY -->
<!-- ========================= -->

<div class="panel p-4">

  <div class="d-flex justify-content-between align-items-center mb-3">

    <div>

      <h2 class="h6 mb-1">
        Attendance History
      </h2>

      <p class="text-muted small mb-0">
        Your previous attendance records
      </p>

    </div>

  </div>



  <% if (!attendance.length) { %>


    <div class="empty-state py-5">

      <i class="bi bi-calendar-check"></i>

      <p class="mb-0">
        No attendance records found.
      </p>

    </div>


  <% } else { %>



    <!-- ============================= -->
    <!-- DESKTOP TABLE -->
    <!-- ============================= -->

    <div class="my-attendance-table-desktop">

      <div class="table-responsive">

        <table class="table align-middle mb-0">

          <thead>

            <tr>
              <th>Date</th>
              <th>Check In</th>
              <th>Check Out</th>
              <th>Status</th>
              <th>Working Hours</th>
            </tr>

          </thead>


          <tbody>

            <% attendance.forEach(record => { %>

              <tr>

                <td class="fw-semibold">

                  <%= dayjs(record.date).format('MMM D, YYYY') %>

                </td>


                <td>

                  <% if (record.checkIn) { %>

                    <%= dayjs(record.checkIn).format('hh:mm A') %>

                  <% } else { %>

                    —

                  <% } %>

                </td>


                <td>

                  <% if (record.checkOut) { %>

                    <%= dayjs(record.checkOut).format('hh:mm A') %>

                  <% } else { %>

                    —

                  <% } %>

                </td>


                <td>

                  <span class="stamp
                    <%= record.status === 'Late'
                      ? 'stamp-warning'
                      : record.status === 'Present'
                      ? 'stamp-completed'
                      : 'stamp-critical' %>">

                    <%= record.status %>

                  </span>

                </td>


                <td>

                  <% if (record.checkOut) { %>

                    <%= record.workingHours %> hrs

                  <% } else { %>

                    <span class="text-muted">
                      In progress
                    </span>

                  <% } %>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    </div>



    <!-- ============================= -->
    <!-- MOBILE CARDS -->
    <!-- ============================= -->

    <div class="my-attendance-mobile-list">


      <% attendance.forEach(record => { %>


        <div class="my-attendance-card">


          <!-- CARD HEADER -->

          <div class="my-attendance-card-top">

            <div class="my-attendance-date">

              <div class="my-attendance-icon">
                <i class="bi bi-calendar-check"></i>
              </div>


              <div>

                <strong>
                  <%= dayjs(record.date).format('MMM D, YYYY') %>
                </strong>

                <small>
                  Attendance Record
                </small>

              </div>

            </div>


            <span class="stamp
              <%= record.status === 'Late'
                ? 'stamp-warning'
                : record.status === 'Present'
                ? 'stamp-completed'
                : 'stamp-critical' %>">

              <%= record.status %>

            </span>

          </div>



          <!-- CARD DETAILS -->

          <div class="my-attendance-details">


            <div class="my-attendance-detail">

              <small>
                Check In
              </small>

              <strong>

                <% if (record.checkIn) { %>

                  <%= dayjs(record.checkIn).format('hh:mm A') %>

                <% } else { %>

                  —

                <% } %>

              </strong>

            </div>



            <div class="my-attendance-detail">

              <small>
                Check Out
              </small>

              <strong>

                <% if (record.checkOut) { %>

                  <%= dayjs(record.checkOut).format('hh:mm A') %>

                <% } else { %>

                  —

                <% } %>

              </strong>

            </div>



            <div class="my-attendance-detail">

              <small>
                Working Hours
              </small>

              <% if (record.checkOut) { %>

                <strong>
                  <%= record.workingHours %> hrs
                </strong>

              <% } else { %>

                <strong class="text-muted">
                  In progress
                </strong>

              <% } %>

            </div>


          </div>


        </div>


      <% }) %>


    </div>



  <% } %>

</div>