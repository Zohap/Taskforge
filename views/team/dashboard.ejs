<div class="page-header">
  <div>
    <span class="eyebrow">My Workspace</span>

    <h1 class="h3 mb-0">
      Welcome back, <%= currentUser.name.split(' ')[0] %>
    </h1>

    <p class="text-muted mb-0">
      Here's what's on your plate today.
    </p>
  </div>

  <div class="d-flex gap-2">

  <a href="/team/tasks" class="btn btn-ember">
    <i class="bi bi-list-check me-1"></i>
    View My Tasks
  </a>

  <a href="/attendance" class="btn btn-ember">
    <i class="bi bi-calendar-check me-1"></i>
    Attendance
  </a>

</div>
</div>


<!-- ========================= -->
<!-- STAT CARDS -->
<!-- ========================= -->

<div class="row g-3 mb-4">

  <%- include('../partials/stat-card', {
    icon: 'bi-diagram-3',
    value: stats.assignedProjects,
    label: 'Assigned Projects'
  }) %>

  <%- include('../partials/stat-card', {
    icon: 'bi-list-task',
    value: stats.assignedTasks,
    label: 'Assigned Tasks'
  }) %>

  <%- include('../partials/stat-card', {
    icon: 'bi-hourglass-split',
    value: stats.pendingTasks,
    label: 'Pending Tasks'
  }) %>

  <%- include('../partials/stat-card', {
    icon: 'bi-check2-circle',
    value: stats.completedTasks,
    label: 'Completed Tasks'
  }) %>

</div>

<div class="row g-4 mb-4">

  <div class="col-lg-6">
    <div class="panel p-4 h-100">

      <div class="d-flex justify-content-between align-items-center">

        <div>
          <h2 class="h6 mb-1">Attendance</h2>
          <p class="text-muted small mb-0">
            Manage your daily attendance
          </p>
        </div>

        <i class="bi bi-calendar-check fs-4"></i>

      </div>

      <div class="mt-3">
        <a href="/attendance" class="btn btn-ember">
          Open Attendance
        </a>
      </div>

    </div>
  </div>

</div>
<!-- ========================= -->
<!-- CHARTS -->
<!-- ========================= -->

<div class="row g-4 mb-4">

  <!-- TASK PROGRESS -->
  <div class="col-lg-6">

    <div class="panel p-4 h-100">

      <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
          <h2 class="h6 mb-1">
            Task Progress
          </h2>

          <p class="text-muted small mb-0">
            Overview of your completed and pending tasks
          </p>
        </div>

        <span class="stamp stamp-completed">
          <%= stats.assignedTasks %> Total
        </span>

      </div>


      <!-- Chart Data -->
      <div
        id="teamTaskChartData"
        data-completed="<%= stats.completedTasks %>"
        data-pending="<%= stats.pendingTasks %>">
      </div>


      <!-- Chart -->
      <div style="height:280px; position:relative;">
        <canvas id="teamTaskChart"></canvas>
      </div>

    </div>

  </div>


  <!-- TASK PRIORITY -->
  <div class="col-lg-6">

    <div class="panel p-4 h-100">

      <div class="mb-3">

        <h2 class="h6 mb-1">
          Task Priority
        </h2>

        <p class="text-muted small mb-0">
          Distribution of your assigned tasks by priority
        </p>

      </div>


      <!-- Chart Data -->
      <div
        id="teamPriorityChartData"
        data-low="<%= charts.priority[0] %>"
        data-medium="<%= charts.priority[1] %>"
        data-high="<%= charts.priority[2] %>"
        data-critical="<%= charts.priority[3] %>">
      </div>


      <!-- Chart -->
      <div style="height:280px; position:relative;">
        <canvas id="teamPriorityChart"></canvas>
      </div>

    </div>

  </div>

</div>


<!-- ========================= -->
<!-- PROJECTS + DEADLINES -->
<!-- ========================= -->

<div class="row g-4">

  <!-- MY PROJECTS -->
  <div class="col-lg-7">

    <div class="panel p-4 h-100">

      <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
          <h2 class="h6 mb-1">
            My Projects
          </h2>

          <p class="text-muted small mb-0">
            Projects you're currently assigned to
          </p>
        </div>

        <a href="/team/projects" class="small text-decoration-none">
          View all
          <i class="bi bi-arrow-right"></i>
        </a>

      </div>


      <% if (!myProjects.length) { %>

        <div class="empty-state">

          <i class="bi bi-diagram-3"></i>

          <p class="mb-0">
            You haven't been added to any project yet.
          </p>

        </div>

      <% } else { %>

        <div class="d-flex flex-column gap-2">

          <% myProjects.forEach(p => { %>

            <a
              href="/projects/<%= p._id %>"
              class="list-row d-flex justify-content-between align-items-center text-decoration-none text-reset">

              <div>

                <div class="fw-semibold">
                  <%= p.name %>
                </div>

                <div class="text-muted small">
                  Due <%= dayjs(p.endDate).format('MMM D, YYYY') %>
                </div>

              </div>

              <span class="stamp <%= projectStatusClass(p.status) %>">
                <%= p.status %>
              </span>

            </a>

          <% }) %>

        </div>

      <% } %>

    </div>

  </div>


  <!-- UPCOMING DEADLINES -->
  <div class="col-lg-5">

    <div class="panel p-4 h-100">

      <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
          <h2 class="h6 mb-1">
            Upcoming Deadlines
          </h2>

          <p class="text-muted small mb-0">
            Tasks due within the next 3 days
          </p>
        </div>

        <i class="bi bi-calendar3 text-muted"></i>

      </div>


      <% if (!upcomingDeadlines.length) { %>

        <div class="empty-state py-4">

          <i class="bi bi-calendar-check"></i>

          <p class="mb-0">
            Nothing due in the next 3 days. Nice work!
          </p>

        </div>

      <% } else { %>

        <div class="d-flex flex-column gap-2">

          <% upcomingDeadlines.forEach(t => { %>

            <a
              href="/tasks/<%= t._id %>"
              class="list-row d-flex justify-content-between align-items-center text-decoration-none text-reset py-2 px-3">

              <div>

                <div class="fw-semibold small">
                  <%= t.title %>
                </div>

                <div
                  class="text-muted"
                  style="font-size:.75rem;">

                  <%= t.project.name %>

                </div>

              </div>

              <span class="stamp <%= priorityClass(t.priority) %>">
                <%= t.priority %>
              </span>

            </a>

          <% }) %>

        </div>

      <% } %>

    </div>

  </div>

</div>


<!-- ========================= -->
<!-- CHART.JS -->
<!-- ========================= -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

  document.addEventListener('DOMContentLoaded', function () {

    /* =========================
       TASK PROGRESS CHART
    ========================= */

    const taskData =
      document.getElementById('teamTaskChartData');

    const taskCanvas =
      document.getElementById('teamTaskChart');


    if (taskData && taskCanvas && typeof Chart !== 'undefined') {

      const completed =
        Number(taskData.dataset.completed) || 0;

      const pending =
        Number(taskData.dataset.pending) || 0;


      new Chart(taskCanvas, {

        type: 'doughnut',

        data: {

          labels: [
            'Completed',
            'Pending'
          ],

          datasets: [{

            data: [
              completed,
              pending
            ],

            backgroundColor: [
              '#6c8a5b',
              '#b85c38'
            ],

            borderWidth: 0

          }]

        },

        options: {

          responsive: true,

          maintainAspectRatio: false,

          cutout: '65%',

          plugins: {

            legend: {
              position: 'bottom'
            }

          }

        }

      });

    }


    /* =========================
       TASK PRIORITY CHART
    ========================= */

    const priorityData =
      document.getElementById('teamPriorityChartData');

    const priorityCanvas =
      document.getElementById('teamPriorityChart');


    if (
      priorityData &&
      priorityCanvas &&
      typeof Chart !== 'undefined'
    ) {

      const low =
        Number(priorityData.dataset.low) || 0;

      const medium =
        Number(priorityData.dataset.medium) || 0;

      const high =
        Number(priorityData.dataset.high) || 0;

      const critical =
        Number(priorityData.dataset.critical) || 0;


      new Chart(priorityCanvas, {

        type: 'bar',

        data: {

          labels: [
            'Low',
            'Medium',
            'High',
            'Critical'
          ],

          datasets: [{

            label: 'Tasks',

            data: [
              low,
              medium,
              high,
              critical
            ],

            backgroundColor: [
              '#6c8a5b',
              '#3e5c76',
              '#b85c38',
              '#7a3e48'
            ],

            borderRadius: 6,

            borderSkipped: false

          }]

        },

        options: {

          responsive: true,

          maintainAspectRatio: false,

          scales: {

            y: {

              beginAtZero: true,

              ticks: {
                precision: 0
              }

            }

          },

          plugins: {

            legend: {
              display: false
            }

          }

        }

      });

    }

  });

</script>